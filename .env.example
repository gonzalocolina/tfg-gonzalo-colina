# Copia este archivo a .env y ajusta los valores antes de arrancar el proyecto.

# Secreto JWT (obligatorio). Usa un valor largo y aleatorio en entornos reales.
APP_JWT_SECRET=change-me-in-local-development
APP_JWT_EXPIRATION_MINUTES=120

# Usuario seed del organizador de desarrollo (usuario: organizer)
APP_SEED_ORGANIZER_PASSWORD=organizer

# CORS / WebSocket (desarrollo local)
APP_ALLOWED_ORIGINS=http://*:*,https://*:*

# Directorio de datos H2 e imágenes (opcional). Por defecto start-dev.ps1 usa %LOCALAPPDATA%\mc-tfg
# APP_DATA_DIR=C:/dev/mc-tfg

# Puertos de docker-compose
BACKEND_PORT=8080
FRONTEND_PORT=5175

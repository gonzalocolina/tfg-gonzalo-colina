{
  "name": "frontend-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev-server.mjs",
    "dev:organizer": "vite --config ./apps/organizer/vite.config.js --clearScreen false",
    "dev:player": "vite --config ./apps/player/vite.config.js --clearScreen false",
    "dev:portal": "vite --config ./apps/portal/vite.config.js --clearScreen false",
    "build": "run-s build:portal build:organizer build:player",
    "build:portal": "vite build --config ./apps/portal/vite.config.js",
    "build:organizer": "vite build --config ./apps/organizer/vite.config.js",
    "build:player": "vite build --config ./apps/player/vite.config.js",
    "test": "run-s test:portal test:organizer test:player",
    "test:portal": "vitest run --config ./apps/portal/vite.config.js --passWithNoTests",
    "test:organizer": "vitest run --config ./apps/organizer/vite.config.js",
    "test:player": "vitest run --config ./apps/player/vite.config.js"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.15.0",
    "pinia": "^3.0.4",
    "sockjs-client": "^1.6.1",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "globals": "^17.3.0",
    "happy-dom": "^20.8.4",
    "http-proxy": "^1.18.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "prettier": "3.8.1",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

  @startuml
  left to right direction
  hide circle
  hide methods
  skinparam shadowing true
  skinparam backgroundColor white
  skinparam linetype ortho
  skinparam nodesep 45
  skinparam ranksep 35
  skinparam defaultFontName Arial
  skinparam roundcorner 12
  skinparam classBackgroundColor #FFF8E7
  skinparam classBorderColor #5D5D5D
  skinparam ArrowColor black
  skinparam ArrowThickness 1
  skinparam classAttributeIconSize 0

  title Diagrama entidad-relación de la base de datos

  entity event_organizers {
    * id : BIGINT [PK]
    --
    created_at : TIMESTAMP WITH TIME ZONE
    updated_at : TIMESTAMP WITH TIME ZONE
    username : VARCHAR [UK]
    email : VARCHAR [UK, nullable]
    password_hash : VARCHAR [nullable]
    role : ENUM
    enabled : BOOLEAN
  }

  entity invitations {
    * id : BIGINT [PK]
    --
    created_at : TIMESTAMP WITH TIME ZONE
    updated_at : TIMESTAMP WITH TIME ZONE
    event_id : BIGINT [FK]
    user_id : BIGINT [FK]
    invited_by_user_id : BIGINT [FK, nullable]
    status : ENUM
    responsibilities : VARCHAR
  }

  entity events {
    * id : BIGINT [PK]
    --
    created_at : TIMESTAMP WITH TIME ZONE
    updated_at : TIMESTAMP WITH TIME ZONE
    name : VARCHAR
    configured_player_count : INTEGER
    time_limit_minutes : INTEGER
    status : ENUM
    result : ENUM [nullable]
    event_code : VARCHAR [UK]
    organizer_id : BIGINT [FK]
    villain_hp_max : INTEGER
    villain_hp_current : INTEGER
    scheme_threat_target : INTEGER
    scheme_threat_current : INTEGER
    timer_total_seconds : INTEGER
    timer_remaining_seconds : INTEGER
    timer_status : ENUM
    finish_cause : ENUM [nullable]
    total_reported_villain_damage : INTEGER
    villain_half_hp_notified : BOOLEAN
    villain_quarter_hp_notified : BOOLEAN
    threat_half_notified : BOOLEAN
    threat_three_quarter_notified : BOOLEAN
    timer_thirty_minutes_notified : BOOLEAN
    timer_fifteen_minutes_notified : BOOLEAN
    timer_five_minutes_notified : BOOLEAN
    timer_started_at : TIMESTAMP WITH TIME ZONE [nullable]
    timer_paused_at : TIMESTAMP WITH TIME ZONE [nullable]
    started_at : TIMESTAMP WITH TIME ZONE [nullable]
    finished_at : TIMESTAMP WITH TIME ZONE [nullable]
  }

  entity event_villain {
    * id : BIGINT [PK]
    --
    created_at : TIMESTAMP WITH TIME ZONE
    updated_at : TIMESTAMP WITH TIME ZONE
    event_id : BIGINT [FK, UK]
    villain_definition_id : BIGINT [FK, nullable]
    name : VARCHAR
    type : ENUM
    hp_rule_type : ENUM
    hp_rule_value : INTEGER
    threat_rule_type : ENUM
    threat_rule_value : INTEGER
  }

  entity pods {
    * id : BIGINT [PK]
    --
    created_at : TIMESTAMP WITH TIME ZONE
    updated_at : TIMESTAMP WITH TIME ZONE
    event_id : BIGINT [FK]
    name : VARCHAR
    sort_order : INTEGER
  }

  entity player_table {
    * id : BIGINT [PK]
    --
    created_at : TIMESTAMP WITH TIME ZONE
    updated_at : TIMESTAMP WITH TIME ZONE
    event_id : BIGINT [FK]
    pod_id : BIGINT [FK, nullable]
    identifier : VARCHAR
    player_count : INTEGER
    representative_code : VARCHAR [UK]
    observer_code : VARCHAR [UK]
  }

  entity event_inter_pod_card {
    * id : BIGINT [PK]
    --
    created_at : TIMESTAMP WITH TIME ZONE
    updated_at : TIMESTAMP WITH TIME ZONE
    event_id : BIGINT [FK]
    pod_id : BIGINT [FK]
    source_group_id : BIGINT [FK]
    inter_pod_card_definition_id : BIGINT [FK, nullable]
    card_name : VARCHAR
    card_category : ENUM
    hp_max : INTEGER
    hp_current : INTEGER
    threat_max : INTEGER
    threat_current : INTEGER
    status : ENUM
    image_path : VARCHAR [nullable]
    image_content_type : VARCHAR [nullable]
  }

  entity event_logs {
    * id : BIGINT [PK]
    --
    created_at : TIMESTAMP WITH TIME ZONE
    updated_at : TIMESTAMP WITH TIME ZONE
    event_id : BIGINT [FK]
    group_id : BIGINT [FK, nullable]
    actor_id : BIGINT [FK, nullable]
    reverted_log_id : BIGINT [FK, nullable]
    action_type : VARCHAR
    previous_value : VARCHAR [nullable]
    new_value : VARCHAR [nullable]
    notes : VARCHAR [nullable]
  }

  entity villain_definitions {
    * id : BIGINT [PK]
    --
    created_at : TIMESTAMP WITH TIME ZONE
    updated_at : TIMESTAMP WITH TIME ZONE
    name : VARCHAR
    type : ENUM
    hp_rule_type : ENUM
    hp_rule_value : INTEGER
    threat_rule_type : ENUM
    threat_rule_value : INTEGER
    owner_id : BIGINT [FK, nullable]
  }

  entity inter_pod_card_definitions {
    * id : BIGINT [PK]
    --
    created_at : TIMESTAMP WITH TIME ZONE
    updated_at : TIMESTAMP WITH TIME ZONE
    name : VARCHAR
    type : ENUM
    card_category : ENUM
    default_hp_max : INTEGER
    default_threat_max : INTEGER
    default_status : ENUM
    image_path : VARCHAR [nullable]
    image_content_type : VARCHAR [nullable]
    owner_id : BIGINT [FK, nullable]
  }

  event_organizers ||--o{ events : organizer_id

  events ||--o| event_villain : event_id
  villain_definitions |o--o{ event_villain : villain_definition_id

  events ||--o{ pods : event_id
  events ||--o{ player_table : event_id
  pods |o--o{ player_table : pod_id

  events ||--o{ invitations : event_id
  event_organizers ||--o{ invitations : user_id
  event_organizers |o--o{ invitations : invited_by_user_id

  events ||--o{ event_logs : event_id
  player_table |o--o{ event_logs : group_id
  event_organizers |o--o{ event_logs : actor_id
  event_logs }o--o{ event_logs : reverted_log_id

  event_organizers |o--o{ villain_definitions : owner_id
  event_organizers |o--o{ inter_pod_card_definitions : owner_id

  events ||--o{ event_inter_pod_card : event_id
  pods ||--o{ event_inter_pod_card : pod_id
  player_table ||--o{ event_inter_pod_card : source_group_id
  inter_pod_card_definitions |o--o{ event_inter_pod_card : inter_pod_card_definition_id

  @enduml
